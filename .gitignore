# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- Data (versioned by DVC, not Git) ----
# DVC writes its own /data/.gitignore entries for anything added with `dvc add`.

# ---- Model artifacts ----
# The serving artifact and the small evaluation outputs ARE committed: the
# Docker image built in CI needs model.pt, and there is no cloud DVC remote to
# pull it from. It is only ~1.6 MB. Large sample images stay out.
/artifacts/*
!/artifacts/.gitkeep
!/artifacts/model.pt
!/artifacts/metrics.json
!/artifacts/training_curves.png
!/artifacts/confusion_matrix.png
!/artifacts/classification_report.txt
!/artifacts/deployment_evaluation.json

# ---- MLflow local tracking store ----
mlruns/
mlartifacts/
mlflow.db

# ---- Test / tooling caches ----
.pytest_cache/
.coverage
htmlcov/
.dvc/tmp
.dvc/cache

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
