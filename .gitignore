# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- Data (versioned by DVC, not Git) ----
# DVC writes its own /data/.gitignore entries for anything added with `dvc add`.
/data/processed/*
!/data/processed/.gitkeep

# ---- Model artifacts (versioned by DVC / MLflow) ----
/artifacts/*
!/artifacts/.gitkeep

# ---- MLflow local tracking store ----
mlruns/
mlartifacts/

# ---- Test / tooling caches ----
.pytest_cache/
.coverage
htmlcov/
.dvc/tmp
.dvc/cache

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
